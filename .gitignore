# ------------------------------------------------------------------------------
# 1. SECRETS ET CONFIGURATION LOCALE
# ------------------------------------------------------------------------------
.env
*.key
*.pem
/wordpress-code/wp-config.php

# ------------------------------------------------------------------------------
# 2. STRUCTURE WORDPRESS (On ignore tout sauf notre travail)
# ------------------------------------------------------------------------------
/wordpress-code/*

# Autoriser le dossier wp-content
!/wordpress-code/wp-content/
/wordpress-code/wp-content/*

# ------------------------------------------------------------------------------
# 3. THÈMES : On ignore tout sauf votre thème personnalisé
# ------------------------------------------------------------------------------
!/wordpress-code/wp-content/themes/
/wordpress-code/wp-content/themes/*
!/wordpress-code/wp-content/themes/lahar/

# ------------------------------------------------------------------------------
# 4. DOSSIERS SYSTÈME À CONSERVER VIDES (Gestion via .gitkeep)
# ------------------------------------------------------------------------------

# On ignore le contenu des uploads, mais on garde le dossier grâce au .gitkeep
!/wordpress-code/wp-content/uploads/
/wordpress-code/wp-content/uploads/*
!/wordpress-code/wp-content/uploads/.gitkeep

# Idem pour le cache (utile pour la performance)
!/wordpress-code/wp-content/cache/
/wordpress-code/wp-content/cache/*
!/wordpress-code/wp-content/cache/.gitkeep

# Idem pour les upgrades temporaires
!/wordpress-code/wp-content/upgrade/
/wordpress-code/wp-content/upgrade/*
!/wordpress-code/wp-content/upgrade/.gitkeep

# ------------------------------------------------------------------------------
# 5. LOGS ET DÉBOGAGE
# ------------------------------------------------------------------------------
*.log
/wordpress-code/wp-content/debug.log

# ------------------------------------------------------------------------------
# 6. VOLUMES DOCKER ET SYSTÈME
# ------------------------------------------------------------------------------
/volumes/
/data/

.podman-history
.podman-conf
.DS_Store
Thumbs.db
desktop.ini

.vscode/
.idea/
*.swp
*~